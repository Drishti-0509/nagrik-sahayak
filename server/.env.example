# ========================================================
# Nagrik Sahayak Server Environment Variables
# Copy this file to .env and configure your values.
# ========================================================

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB Connection String (Atlas or Local)
# For MongoDB Atlas:
# 1. Create a free cluster on cloud.mongodb.com
# 2. Add Network Access: 0.0.0.0/0 (or your IP)
# 3. Create a Database User with readWrite permissions
# 4. Use connection URI: mongodb+srv://<username>:<password>@cluster.mongodb.net/nagrik_sahayak?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/nagrik_sahayak

# JWT Authentication
# Generate a strong 64-char secret: openssl rand -hex 32
JWT_SECRET=replace_with_a_secure_random_jwt_secret_key_minimum_32_chars
JWT_EXPIRES_IN=7d

# Google Gemini AI Configuration (Optional)
# Obtain API key from Google AI Studio (https://aistudio.google.com/)
# If missing, system falls back gracefully to deterministic rule-based NLP classification
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Default SLA Settings (Hours)
SLA_LOW_HOURS=120
SLA_MEDIUM_HOURS=72
SLA_HIGH_HOURS=48
SLA_URGENT_HOURS=24

# AI Duplicate Complaint Detection (Phase 4B)
# Cosine similarity threshold for duplicate warnings (0.0 to 1.0, default 0.78)
DUPLICATE_SIMILARITY_THRESHOLD=0.78

# External Email Notifications via Nodemailer (Phase 4D)
EMAIL_NOTIFICATIONS_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=notifications@nagriksahayak.gov.in
SMTP_PASS=your_smtp_app_password
SMTP_SECURE=false
FROM_EMAIL="Nagrik Sahayak" <no-reply@nagriksahayak.gov.in>

# External SMS Notifications (Phase 4D)
# Providers: mock, twilio
SMS_NOTIFICATIONS_ENABLED=false
SMS_PROVIDER=mock
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890
